---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCard from '../components/BookingCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Book a Free Chat with Lyncia"
  description="Book a free, no-obligation chat with Lyncia Podmore at YOU Coaching, or send a message. Coaching, strengths and communication workshops in Wellington and online."
>
  <section class="bg-gradient-to-b from-mint-soft to-cream">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">Get in touch</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-medium sm:text-5xl">Start with a conversation</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">
        Book a free initial chat at a time that suits you. There's no obligation. We'll talk about what's going on, and
        I'll tell you honestly whether I can help.
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="container-page grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <BookingCard />
      </div>
      <aside class="space-y-6">
        <div class="rounded-3xl bg-navy p-8 text-white">
          <h2 class="text-xl text-white">Prefer to talk?</h2>
          <p class="mt-3 text-white/80">Give me a call. If I'm with a client, leave a message and I'll call you back.</p>
          <a href={site.phoneHref} class="mt-4 block font-display text-2xl text-white no-underline">{site.phone}</a>
        </div>
        <div class="rounded-3xl border border-navy/10 bg-white p-8">
          <h2 class="text-xl">Where to find me</h2>
          <address class="mt-3 not-italic text-muted">
            {site.address.street}<br />{site.address.locality}<br />{site.address.city} {site.address.postcode}
          </address>
          <a href={site.mapUrl} class="mt-3 inline-block" rel="noopener" target="_blank">Open in Google Maps</a>
          <p class="mt-4 text-sm text-muted">I also coach online, wherever you are.</p>
        </div>
      </aside>
    </div>
  </section>

  <section id="message" class="scroll-mt-24 border-t border-navy/10 bg-white py-16 sm:py-20">
    <div class="container-page max-w-3xl">
      <h2 class="text-3xl">Or send a message</h2>
      <p class="mt-3 text-muted">Tell me a little about what you're looking for and I'll get back to you.</p>
      <div class="mt-8">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
