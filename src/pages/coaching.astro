---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import { services } from '../data/services';
import { faqSchema, serviceSchema } from '../data/schema';
import listening from '../assets/photos/lyncia-listening.jpg';
import portrait from '../assets/photos/lyncia-portrait.jpg';

const service = services.find((s) => s.slug === 'coaching')!;

const reasons = [
  { title: "You're stuck", text: 'In your job, in the way you do your job, in a relationship. Something isn\'t working and you can\'t quite see why.' },
  { title: 'You keep repeating a pattern', text: '"Every time I\'m in this situation, this happens." Part of my job is noticing the pattern so you can do something about it.' },
  { title: 'You have a decision to make', text: 'Starting something, growing something, changing direction. Sometimes the answer turns out to be "I don\'t want that as much as I thought", and that\'s a good outcome too.' },
  { title: 'Something feels slightly off', text: 'Life looks fine from the outside, but there\'s an unease you want to understand.' },
  { title: 'Your confidence has taken a knock', text: 'You know what you want to do. You just need to believe you can do it.' },
  { title: 'You lead people', text: "You need a confidential sounding board. Someone outside the organisation to think out loud with." },
];

const faqs = [
  { q: 'How many sessions will I need?', a: "It depends on what you're working on. Some people come for a handful of sessions around a particular decision or change; others check in regularly over a longer period. We'll talk about what makes sense in our first chat, and you're never locked in." },
  { q: 'How long is a session?', a: 'Coaching sessions are 60 minutes.' },
  { q: 'Do you coach online?', a: 'Yes. A lot of my one-to-one coaching happens online, so it doesn\'t matter where you are. If you\'re in Wellington, you\'re welcome to come to my office in the central city.' },
  { q: 'Is coaching the same as counselling or therapy?', a: "No. Coaching is forward-focused. It's about where you are now and what you want to change. If I think something would be better supported by a counsellor or therapist, I'll tell you." },
  { q: 'Is it confidential?', a: 'Yes. What you say in our sessions stays between us. That applies even when your employer is paying for the coaching.' },
  { q: 'Can my employer pay for coaching?', a: 'Often, yes. Many employers set aside a professional development budget. See the page on using your PD budget for how to ask.' },
];

const description = 'One-to-one coaching in Wellington and online with Lyncia Podmore. A strengths-based, non-judgemental space to get unstuck, make decisions and build confidence.';
---

<BaseLayout
  title="Life & Career Coaching in Wellington and Online"
  description={description}
  schema={[serviceSchema('One-to-one coaching', description, '/coaching'), faqSchema(faqs)]}
>
  <PageHero
    eyebrow="One-to-one coaching"
    title="Time to think, with someone who's really listening"
    lead="Coaching is mostly you talking and me listening. Then I help you notice the patterns, look at your options and find the confidence to take your next step, in your own way."
    image={portrait}
    imageAlt="Lyncia Podmore"
  />

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl sm:text-4xl">What people come to me with</h2>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Almost always, people come to coaching because they've decided it's time to change something. It might be
        personal, professional or about your business. You might be excited and want to keep the momentum going, or you
        might be stuck. Either is a fine place to start.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <div class="rounded-2xl border border-navy/10 bg-white p-6">
            <h3 class="text-lg">{r.title}</h3>
            <p class="mt-2 text-muted">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mint-soft py-16 sm:py-20">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">How I work</h2>
        <div class="mt-6 space-y-4 text-lg text-muted">
          <p>
            <strong class="text-navy">I won't tell you what to do.</strong> I can't, and it wouldn't work if I did. What I
            can do is have the kind of conversation that leaves you clearer. Sometimes that's "Yes, I'm ready to do
            this." Sometimes it's "Actually, I don't want that as much as I thought." Both are progress.
          </p>
          <p>
            <strong class="text-navy">I start with your strengths.</strong> I focus on what comes naturally to you. I'm not
            trying to turn you into someone else; I want you to be more fully yourself and use that to get where you want
            to go. Often I use the Gallup CliftonStrengths assessment to help.
          </p>
          <p>
            <strong class="text-navy">Communication runs through everything.</strong> How we talk to other people, and to
            ourselves, shapes a lot of what happens to us. We'll look at both.
          </p>
          <p>
            <strong class="text-navy">It's calm and non-judgemental.</strong> No hype and no "unleash your inner
            greatness". Just honest, practical conversations in a safe and confidential setting.
          </p>
        </div>
      </div>
      <Image src={listening} alt="Lyncia listening to a coaching client" widths={[500, 800]} sizes="(min-width: 1024px) 540px, 90vw" class="aspect-square w-full rounded-3xl object-cover" />
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="eyebrow">For leaders</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">A sounding board when there's nobody else to ask</h2>
        <p class="mt-5 text-lg text-muted">
          The more senior you are, the fewer people you can think out loud with. You don't want to take it all home every
          night, and some things you can't share with your board or your team. I work with chief executives and senior
          leaders as a confidential thinking partner. We talk through the situation, how a decision might land with the
          people involved, and what you know that could help.
        </p>
      </div>
      <aside class="self-start rounded-3xl bg-navy p-8 text-white">
        <h3 class="text-xl text-white">The practical bits</h3>
        <dl class="mt-5 space-y-4 text-white/80">
          <div><dt class="font-display text-white">Format</dt><dd>{service.format}</dd></div>
          <div><dt class="font-display text-white">Session length</dt><dd>60 minutes</dd></div>
          <div><dt class="font-display text-white">Investment</dt><dd>{service.price ?? "Let's talk about it in your free initial chat"}</dd></div>
        </dl>
        <a href="/contact" class="btn-light mt-7 w-full">Book a free initial chat</a>
      </aside>
    </div>
  </section>

  <Testimonials service="coaching" />
  <FAQ items={faqs} />
  <CTA />
</BaseLayout>
