---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import session from '../assets/photos/strengths-session.jpg';

const problems = [
  { title: '"They\'d rather email than pick up the phone"', text: 'Newer staff avoid calling clients and email everything instead. Clients get frustrated, and the relationships that keep them loyal never get built. When something goes wrong, it\'s much easier to leave someone you don\'t really know.' },
  { title: '"It\'s easier to just do it myself"', text: 'Managers ask for something, get back something different, and end up redoing it. You\'re paying people to do work their managers end up doing themselves.' },
  { title: 'Great at the job, new to managing people', text: 'People get promoted for their technical skill and suddenly need to lead, give feedback and handle difficult conversations, often with no support.' },
  { title: 'A team that doesn\'t quite click', text: 'Good people, but there\'s friction, misunderstanding, or a sense that everyone is working in their own silo.' },
];

const offers = [
  { title: 'Team strengths sessions', text: 'Gallup CliftonStrengths for the whole team, so people understand what each person brings and how to work with each other.', href: '/strengths' },
  { title: 'Communication workshops', text: 'Practical communication skills, delivered in a format that suits your workplace, from the full Transforming Communication™ programme to a session built around one specific problem.', href: '/workshops' },
  { title: 'Coaching for leaders', text: 'Confidential one-to-one coaching for managers and senior leaders: a sounding board, and support through change.', href: '/coaching' },
  { title: 'Manager and team pairings', text: 'Sit managers down with their direct reports and both strengths profiles, so they learn how to explain, ask and support each other well.', href: '/strengths' },
];

const steps = [
  { title: 'We talk', text: 'You tell me what\'s happening and what you\'d like to be different. I ask a lot of questions.' },
  { title: 'I suggest an approach', text: 'A clear proposal with the format, length and cost. Nothing off the shelf unless it fits.' },
  { title: 'We do the work', text: 'In person in Wellington, at your workplace, or online, whatever works best.' },
  { title: 'We check in', text: 'We look at what has changed, and what might help next.' },
];
---

<BaseLayout
  title="Team Development, Strengths & Communication Training for Organisations, Wellington"
  description="Help your people communicate better, understand each other's strengths and grow into their potential. Tailored team workshops and leadership coaching from YOU Coaching, Wellington."
>
  <PageHero
    eyebrow="For organisations"
    title="Your people are capable of more than you're seeing"
    lead="The biggest waste in most organisations isn't laziness. It's people who never get to use what they're good at, because nobody has shown them. I help teams understand their strengths and communicate well, so their technical skill turns into real results."
    image={session}
    imageAlt="Lyncia working through a strengths report with a client"
  >
    <Fragment slot="actions">
      <a href="/contact" class="btn-primary">Talk about your team</a>
      <a href="#how-it-works" class="btn-secondary">How it works</a>
    </Fragment>
  </PageHero>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl sm:text-4xl">Sound familiar?</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {problems.map((p) => (
          <div class="rounded-3xl border border-navy/10 bg-white p-7">
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-3 text-muted">{p.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl text-lg text-muted">
        None of these are about people being bad at their jobs. They're about communication and self-awareness, and both
        can be learned. Back up your team's technical expertise with good communication skills, and everyone wins: your
        people, your clients and your business.
      </p>
    </div>
  </section>

  <section class="bg-mint-soft py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl sm:text-4xl">Ways I work with organisations</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {offers.map((o) => (
          <a href={o.href} class="group rounded-3xl bg-white p-7 no-underline shadow-sm transition hover:shadow-md">
            <h3 class="text-xl group-hover:text-teal-deep">{o.title}</h3>
            <p class="mt-3 text-muted">{o.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="scroll-mt-24 py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-3xl sm:text-4xl">How it works</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li>
            <span class="flex size-12 items-center justify-center rounded-full bg-navy font-display text-lg text-white">{i + 1}</span>
            <h3 class="mt-4 text-xl">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials service="strengths" heading="What teams say" />
  <CTA heading="Tell me about your team" text="Book a free initial chat. There's no obligation. If I'm not the right fit, I'll tell you." primaryLabel="Book a free chat" />
</BaseLayout>
