---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for couldn't be found.">
  <section class="py-24">
    <div class="container-page max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-medium sm:text-5xl">That page has wandered off</h1>
      <p class="mt-5 text-lg text-muted">It may have moved when the site was updated. Try one of these instead.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Home</a>
        <a href="/blog" class="btn-secondary">Blog</a>
        <a href="/contact" class="btn-secondary">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
