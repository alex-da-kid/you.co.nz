---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---

<section class="border-b border-navy/10 bg-gradient-to-b from-mint-soft to-cream">
  <div class:list={['container-page grid items-center gap-10 py-14 sm:py-20', image && 'lg:grid-cols-[1.2fr_1fr]']}>
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-medium leading-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">{lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <slot name="actions">
          <a href="/contact" class="btn-primary">Book a free chat</a>
        </slot>
      </div>
    </div>
    {image && (
      <Image src={image} alt={imageAlt} widths={[400, 700]} sizes="(min-width: 1024px) 420px, 90vw" class="aspect-[4/3] w-full rounded-3xl object-cover shadow-lg lg:aspect-square" loading="eager" />
    )}
  </div>
</section>
