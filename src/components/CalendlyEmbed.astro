---
import { site } from '../data/site';
---

<div class="overflow-hidden rounded-3xl border border-navy/10 bg-white">
  <div
    class="calendly-inline-widget min-h-[700px] w-full"
    data-url={`${site.calendly}?hide_gdpr_banner=1&primary_color=1d6e83`}
  >
    <noscript>
      <p class="p-8">
        <a href={site.calendly}>Open Lyncia's booking page</a>
      </p>
    </noscript>
  </div>
</div>
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
