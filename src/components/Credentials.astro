---
import { Image } from 'astro:assets';
import gallup from '../assets/badges/gallup.png';
import ecd from '../assets/badges/emotional-culture-deck.png';
import { credentials } from '../data/site';
---

<div class="rounded-3xl border border-navy/10 bg-white p-7 sm:p-9">
  <h3 class="text-xl">Qualifications and accreditations</h3>
  <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
    {credentials.map((c) => (
      <li class="flex gap-3">
        <svg class="mt-1 size-4 shrink-0 text-teal" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
        <span>{c}</span>
      </li>
    ))}
  </ul>
  <div class="mt-7 flex items-center gap-6">
    <Image src={gallup} alt="Gallup Certified Strengths Coach badge" width={88} />
    <Image src={ecd} alt="Emotional Culture Deck Elephant Rider Practitioner badge" width={84} />
  </div>
</div>
