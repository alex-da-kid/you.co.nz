---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-navy/10 bg-cream/90 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="YOU Coaching home">
      <Image src={logo} alt="YOU Coaching" width={120} class="h-auto w-[104px] sm:w-[120px]" loading="eager" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-display text-[15px]">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'no-underline transition-colors hover:text-teal-deep',
                isActive(item.href) ? 'text-teal-deep' : 'text-navy',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-primary hidden px-5 py-2.5 text-sm sm:inline-flex">Book a free chat</a>
      <details class="group relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-navy/20 text-navy [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-14 w-64 rounded-2xl border border-navy/10 bg-white p-3 shadow-xl">
          <ul class="font-display">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="block rounded-lg px-4 py-3 text-navy no-underline hover:bg-mint-soft">{item.label}</a>
              </li>
            ))}
            <li class="mt-2 border-t border-navy/10 pt-3">
              <a href="/contact" class="btn-primary w-full">Book a free chat</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
