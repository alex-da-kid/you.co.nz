---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy text-white/80">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-display text-2xl text-white">YOU Coaching</p>
      <p class="mt-3 max-w-sm">
        Calm, practical coaching and workshops with Lyncia Podmore. Based in Wellington, working with people across New Zealand and online.
      </p>
      <a href="/contact" class="btn-light mt-6">Book a free chat</a>
    </div>

    <nav aria-label="Footer">
      <p class="font-display text-white">Explore</p>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => <li><a href={item.href} class="text-white/80 no-underline hover:text-white">{item.label}</a></li>)}
        <li><a href="/for-professionals" class="text-white/80 no-underline hover:text-white">Using your PD budget</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-display text-white">Get in touch</p>
      <address class="mt-3 space-y-2 not-italic">
        <p><a href={site.phoneHref} class="text-white/80 no-underline hover:text-white">{site.phone}</a></p>
        <p>
          <a href={site.mapUrl} class="text-white/80 no-underline hover:text-white" rel="noopener" target="_blank">
            {site.address.street}<br />{site.address.locality}<br />{site.address.city} {site.address.postcode}
          </a>
        </p>
      </address>
      <ul class="mt-4 flex gap-4">
        <li><a href={site.social.linkedin} class="text-white/80 hover:text-white" rel="noopener" target="_blank">LinkedIn</a></li>
        <li><a href={site.social.facebook} class="text-white/80 hover:text-white" rel="noopener" target="_blank">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-sm text-white/60 sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}</p>
      <p>Wellington, Aotearoa New Zealand</p>
    </div>
  </div>
</footer>
