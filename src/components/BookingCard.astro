---
import { site } from '../data/site';

// Lyncia's "Initial Chat" event type in Calendly (30 minutes).
const initialChat = `${site.calendly}/test-event`;
---

<div class="rounded-3xl border border-navy/10 bg-white p-8 sm:p-10">
  <svg class="size-10 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <rect x="3" y="4.5" width="18" height="16" rx="3" />
    <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
  </svg>
  <h2 class="mt-5 text-2xl sm:text-3xl">Book a time that suits you</h2>
  <p class="mt-3 text-lg text-muted">
    Pick a time in Lyncia's calendar. You'll get a confirmation email straight away.
  </p>
  <a href={initialChat} target="_blank" rel="noopener" class="btn-primary mt-7 w-full sm:w-auto">
    Schedule a 30-minute, no-obligation initial chat with Lyncia
  </a>
</div>
